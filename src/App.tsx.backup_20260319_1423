import { useState, useMemo, useEffect, useCallback } from 'react';
import { Toaster, toast } from 'sonner';
import { X, History as HistoryIcon, ShoppingCart, Save, Printer, CreditCard, Banknote, QrCode, Edit3, Settings, Utensils, ShoppingBag, ShieldCheck } from 'lucide-react';
import { createClient } from '@supabase/supabase-js';

const SB_URL = import.meta.env.VITE_SUPABASE_URL || "";
const SB_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY || "";
const supabase = createClient(SB_URL, SB_KEY);

const TABLES = ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10"];
const DOJO_GREEN = "#00CC66";
const CHARCOAL = "#1A1A1A";

interface MenuItem { id: string; name: string; price: number; profile: 'hot_food' | 'cold_food' | 'zero_rated'; category: string; qty?: number; orderId?: string; sent?: boolean; }
interface TableState { id: string; transaction_id: string; table_status: string; orders: MenuItem[]; }

const INITIAL_MENU: MenuItem[] = [
  { id: 's1', name: 'BRUSCHETTA', price: 4.40, profile: 'cold_food', category: 'STARTERS' },
  { id: 's2', name: "MO' MANGIO! (VG)", price: 4.95, profile: 'cold_food', category: 'STARTERS' },
  { id: 's3', name: 'PANZANELLA (V)', price: 4.95, profile: 'cold_food', category: 'STARTERS' },
  { id: 's4', name: 'DA NORD A SUD', price: 5.45, profile: 'cold_food', category: 'STARTERS' },
  { id: 's5', name: 'ROCKET SALAD (VG)', price: 6.50, profile: 'cold_food', category: 'STARTERS' },
  { id: 's6', name: 'BURRATA (V)', price: 8.50, profile: 'cold_food', category: 'STARTERS' },
  { id: 'p1', name: 'RAGÚ NAPO Napoletano', price: 12.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p2', name: 'PICI CARBONARA', price: 12.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p3', name: "PICI AMATRICIANA", price: 12.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p4', name: 'GRICIA', price: 12.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p5', name: 'PUTTANESCA', price: 12.00, profile: 'hot_food', category: 'PASTA' },
  { id: 'p6', name: 'CACIO E PEPE (V)', price: 11.80, profile: 'hot_food', category: 'PASTA' },
  { id: 'p7', name: 'ORECCHIETTE PUGLIESI', price: 12.00, profile: 'hot_food', category: 'PASTA' },
  { id: 'p8', name: 'PICI DI MEZZANOTTE (V)', price: 9.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p9', name: 'POMODORO (V)', price: 9.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p10', name: 'ARRABBIATA (V)', price: 9.50, profile: 'hot_food', category: 'PASTA' },
  { id: 'p11', name: 'LA DELICATA (V)', price: 13.00, profile: 'hot_food', category: 'PASTA' },
  { id: 'kids1', name: 'KIDS MEAL DEAL', price: 13.00, profile: 'cold_food', category: 'KIDS MENU' },
  { id: 'dss1', name: 'TIRAMISU', price: 7.00, profile: 'cold_food', category: 'DESSERTS' },
  { id: 'dss2', name: 'PANNA COTTA', price: 6.50, profile: 'cold_food', category: 'DESSERTS' },
  { id: 'hd1', name: 'ESPRESSO', price: 1.50, profile: 'hot_food', category: 'HOT DRINKS' },
  { id: 'hd2', name: 'MACCHIATO', price: 1.50, profile: 'hot_food', category: 'HOT DRINKS' },
  { id: 'hd3', name: 'CAPPUCCINO', price: 2.50, profile: 'hot_food', category: 'HOT DRINKS' },
  { id: 'sd1', name: 'STILL WATER (S)', price: 2.00, profile: 'zero_rated', category: 'SOFT DRINKS' },
  { id: 'sd2', name: 'STILL WATER (L)', price: 3.00, profile: 'zero_rated', category: 'SOFT DRINKS' },
  { id: 'sd3', name: 'SPARKLING WATER (S)', price: 2.00, profile: 'zero_rated', category: 'SOFT DRINKS' },
  { id: 'sd4', name: 'SPARKLING WATER (L)', price: 3.00, profile: 'zero_rated', category: 'SOFT DRINKS' },
  { id: 'sd5', name: 'SAN PELLEGRINO', price: 2.50, profile: 'hot_food', category: 'SOFT DRINKS' },
  { id: 'sd6', name: 'COCA COLA', price: 2.50, profile: 'hot_food', category: 'SOFT DRINKS' },
  { id: 'sd7', name: 'FOLKINGSTON APPLE JUICE', price: 3.00, profile: 'zero_rated', category: 'SOFT DRINKS' },
  { id: 'ex1', name: 'LARGE PORTION', price: 4.00, profile: 'hot_food', category: 'EXTRAS' },
  { id: 'ex2', name: 'EXTRA PARMESAN', price: 1.00, profile: 'hot_food', category: 'EXTRAS' },
  { id: 'ex3', name: 'GLUTEN FREE PASTA', price: 3.00, profile: 'hot_food', category: 'EXTRAS' },
  { id: 'ex5', name: 'EXTRA PECORINO', price: 1.50, profile: 'hot_food', category: 'EXTRAS' },
  { id: 'open', name: '⊕ OPEN FOOD', price: 0, profile: 'hot_food', category: 'EXTRAS' }
];

export default function App() {
  const [activeTable, setActiveTable] = useState("01");
  const [v4Tables, setV4Tables] = useState<TableState[]>([]);
  const [hudStats, setHudStats] = useState({ hotTables: 0, lastGold: 0 });
  const [menu, setMenu] = useState<MenuItem[]>(() => {
    const saved = localStorage.getItem('mm_menu_v14');
    return saved ? JSON.parse(saved) : INITIAL_MENU;
  });
  
  const [activeCat, setActiveCat] = useState("PASTA");
  const [orderType, setOrderType] = useState<'dine-in' | 'takeaway'>('dine-in');
  const [showSettle, setShowSettle] = useState(false);
  const [showHistory, setShowHistory] = useState(false);
  const [showAdmin, setShowAdmin] = useState(false);
  const [splitPay, setSplitPay] = useState({ card: 0, cash: 0, atoa: 0, tips: 0 });

  const updateHUD = useCallback(async () => {
    const { data: tables } = await supabase.from('active_tables').select('orders');
    const { data: ledger } = await supabase.from('financial_ledger').select('gross_value').order('created_at', { ascending: false }).limit(1);
    setHudStats({
      hotTables: tables?.filter(t => t.orders && t.orders.length > 0).length || 0,
      lastGold: ledger?.[0]?.gross_value || 0
    });
  }, []);

  const syncV4 = useCallback(async () => {
    const { data } = await supabase.from('active_tables').select('*');
    const synced = TABLES.map(tNum => {
      const dbRow = data?.find(r => r.table_number === tNum);
      return { id: tNum, transaction_id: dbRow?.transaction_id || crypto.randomUUID(), table_status: dbRow?.table_status || 'open', orders: dbRow?.orders || [] };
    });
    setV4Tables(synced);
    updateHUD();
  }, [updateHUD]);

  useEffect(() => {
    syncV4();
    const channel = supabase.channel('realtime').on('postgres_changes', { event: '*', schema: 'public', table: 'active_tables' }, syncV4).subscribe();
    return () => { supabase.removeChannel(channel); };
  }, [syncV4]);

  const currentTable = v4Tables.find(t => t.id === activeTable) || { id: activeTable, orders: [], transaction_id: '', table_status: 'open' };
  
  const totals = useMemo(() => {
    let gross = 0;
    currentTable.orders.forEach(item => { gross += item.price * (item.qty || 1); });
    return { gross, vat: gross - (gross / 1.2) };
  }, [currentTable.orders]);

  const saveToTable = async () => {
    if (currentTable.orders.length === 0) return;
    const { error } = await supabase.from('active_tables').upsert({ table_number: activeTable, orders: currentTable.orders, transaction_id: currentTable.transaction_id, table_status: 'open' }, { onConflict: 'table_number' });
    if (!error) toast.success("GOLD SECURED");
  };

  const handlePrint = () => {
    const printData = `MO MANGIO - T${activeTable}\nTOTAL: GBP ${totals.gross.toFixed(2)}\nGRAZIE!`;
    const printUrl = `starpassprnt://v1/print/silent?data=${encodeURIComponent(printData)}&back=${encodeURIComponent(window.location.href)}`;
    if (/iPad|iPhone|iPod/.test(navigator.userAgent)) {
      window.location.assign(printUrl);
    } else {
      toast.info("Printer protocol (iPad only)");
    }
  };

  const finalize = async () => {
    const lookupNum = parseInt(activeTable, 10);
    const payMethod = splitPay.atoa > 0 ? 'atoa' : (splitPay.cash > 0 ? 'cash' : 'card');
    const { data: tableData } = await supabase.from('restaurant_tables').select('id').eq('table_number', lookupNum).maybeSingle();
    if (!tableData?.id) { toast.error(`T${lookupNum} Unreachable`); return; }

    const { error: rpcError } = await supabase.rpc('settle_and_clear_v2', { 
      target_table_id: lookupNum, 
      gross_val: totals.gross, 
      vat_val: totals.vat, 
      pay_method: payMethod, 
      order_type_val: orderType, 
      meta_data: { items: currentTable.orders, tips: splitPay.tips, split: splitPay, build: "v5.5-HUD" }
    });

    if (!rpcError) {
      setV4Tables(prev => prev.map(t => t.id === activeTable ? { ...t, orders: [] } : t));
      setShowSettle(false); setSplitPay({ card: 0, cash: 0, atoa: 0, tips: 0 });
      toast.success("GOLD CAPTURED");
      updateHUD();
    } else toast.error(rpcError.message);
  };

  return (
    <div style={{ position: 'fixed', inset: 0, display: 'flex', flexDirection: 'column', background: CHARCOAL, color: 'white', fontFamily: 'monospace' }}>
      <Toaster theme="dark" position="top-center" richColors />
      <header style={{ background: '#000', borderBottom: `2px solid ${DOJO_GREEN}` }}>
        <div style={{ padding: '10px 15px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: '#080808' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <ShieldCheck size={20} color={DOJO_GREEN} />
            <span style={{ fontWeight: 'bold', fontSize: '12px', letterSpacing: '1px' }}>SENTINEL HUD V5.5</span>
          </div>
          <div style={{ display: 'flex', gap: '20px' }}>
            <div style={{ textAlign: 'right' }}>
              <div style={{ fontSize: '9px', opacity: 0.5 }}>HOT TABLES</div>
              <div style={{ color: DOJO_GREEN, fontWeight: '900', fontSize: '14px' }}>{hudStats.hotTables}</div>
            </div>
            <div style={{ textAlign: 'right' }}>
              <div style={{ fontSize: '9px', opacity: 0.5 }}>LAST GOLD</div>
              <div style={{ color: DOJO_GREEN, fontWeight: '900', fontSize: '14px' }}>£{hudStats.lastGold.toFixed(2)}</div>
            </div>
          </div>
        </div>
        <div style={{ display: 'flex', gap: '8px', padding: '10px', overflowX: 'auto', alignItems: 'center' }}>
          {TABLES.map(t => (
            <button key={t} onClick={() => setActiveTable(t)} style={{ height: '44px', minWidth: '55px', border: `1px solid ${activeTable === t ? DOJO_GREEN : '#222'}`, color: activeTable === t ? DOJO_GREEN : '#666', background: 'transparent' }}>T{t}</button>
          ))}
          <button onClick={() => setShowHistory(!showHistory)} style={{ height: '44px', minWidth: '55px', border: '1px solid #333', background: 'transparent', display: 'flex', alignItems: 'center', justifyContent: 'center' }}><HistoryIcon size={20} color={DOJO_GREEN} /></button>
        </div>
        <div style={{ display: 'flex', background: '#111', alignItems: 'center', justifyContent: 'space-between' }}>
          <div style={{ display: 'flex', overflowX: 'auto' }}>
            {Array.from(new Set(menu.map(m => m.category))).map(cat => (
              <button key={cat} onClick={() => setActiveCat(cat)} style={{ padding: '12px 20px', background: activeCat === cat ? DOJO_GREEN : 'transparent', color: activeCat === cat ? '#000' : '#fff', border: 'none' }}>{cat}</button>
            ))}
          </div>
          <button onClick={() => setShowAdmin(!showAdmin)} style={{ padding: '12px', color: showAdmin ? DOJO_GREEN : '#444', background: 'transparent', border: 'none' }}>
            <Settings size={22} />
          </button>
        </div>
      </header>
      <main style={{ flexGrow: 1, display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '8px', padding: '8px', overflowY: 'auto' }}>
        {menu.filter(m => m.category === activeCat).map(item => (
          <button key={item.id} onClick={() => {
            if (showAdmin) {
              const n = prompt("NAME:", item.name); const p = prompt("PRICE:", item.price.toString());
              if (n && p) {
                const updated = menu.map(m => m.id === item.id ? { ...m, name: n.toUpperCase(), price: parseFloat(p) } : m);
                setMenu(updated); localStorage.setItem('mm_menu_v14', JSON.stringify(updated));
              }
              return;
            }
            const p = item.id === 'open' ? (parseFloat(prompt("Price:") || "0")) : item.price;
            const newOrders = [...currentTable.orders, { ...item, qty: 1, price: p, orderId: crypto.randomUUID() }];
            setV4Tables(v4Tables.map(t => t.id === activeTable ? { ...t, orders: newOrders } : t));
          }} style={{ background: '#222', border: showAdmin ? `1px dashed ${DOJO_GREEN}` : '1px solid #333', padding: '10px', textAlign: 'left', minHeight: '80px', position: 'relative' }}>
            <div style={{ fontSize: '11px', opacity: 0.5 }}>{item.category}</div>
            <div style={{ fontSize: '14px', margin: '4px 0' }}>{item.name}</div>
            <div style={{ color: DOJO_GREEN, fontWeight: '900' }}>£{item.price.toFixed(2)}</div>
            {showAdmin && <Edit3 size={12} style={{ position: 'absolute', top: 8, right: 8, color: DOJO_GREEN }} />}
          </button>
        ))}
      </main>
      <footer style={{ background: '#000', borderTop: `2px solid ${DOJO_GREEN}`, padding: '15px', display: 'flex', gap: '15px', alignItems: 'center' }}>
        <div style={{ flexGrow: 1, fontSize: '18px', fontWeight: 'bold' }}><ShoppingCart size={22} color={DOJO_GREEN} style={{ verticalAlign: 'middle', marginRight: '8px' }} /> £{totals.gross.toFixed(2)}</div>
        <button onClick={saveToTable} style={{ background: '#111', border: `1px solid ${DOJO_GREEN}`, color: DOJO_GREEN, padding: '12px' }}><Save size={20}/></button>
        <button onClick={handlePrint} style={{ background: '#111', border: `1px solid ${DOJO_GREEN}`, color: DOJO_GREEN, padding: '12px', display: 'flex', alignItems: 'center' }}>
          <Printer size={20} />
        </button>
        <div style={{ display: 'flex', background: '#111', border: '1px solid #333' }}>
          <button onClick={() => setOrderType('dine-in')} style={{ padding: '10px', background: orderType === 'dine-in' ? DOJO_GREEN : 'transparent', color: orderType === 'dine-in' ? '#000' : '#666', border: 'none' }}><Utensils size={18}/></button>
          <button onClick={() => setOrderType('takeaway')} style={{ padding: '10px', background: orderType === 'takeaway' ? DOJO_GREEN : 'transparent', color: orderType === 'takeaway' ? '#000' : '#666', border: 'none' }}><ShoppingBag size={18}/></button>
        </div>
        <button onClick={() => setShowSettle(true)} style={{ background: DOJO_GREEN, color: '#000', padding: '12px 24px', fontWeight: '900', border: 'none' }}>SETTLE</button>
      </footer>
      {showSettle && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.95)', zIndex: 200, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '20px' }}>
          <div style={{ background: '#111', width: '100%', maxWidth: '400px', padding: '20px', border: `1px solid ${DOJO_GREEN}` }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '20px' }}><span style={{ fontWeight: '900' }}>T{activeTable} SETTLE</span><X onClick={() => setShowSettle(false)} /></div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
              <PaymentLine label="CASH" val={splitPay.cash} set={v => setSplitPay({...splitPay, cash: v})} icon={<Banknote size={16}/>} />
              <PaymentLine label="ATOA" val={splitPay.atoa} set={v => setSplitPay({...splitPay, atoa: v})} icon={<QrCode size={16}/>} />
              <PaymentLine label="CARD" val={splitPay.card} set={v => setSplitPay({...splitPay, card: v})} icon={<CreditCard size={16}/>} />
              <div style={{ borderTop: '1px solid #222', paddingTop: '10px' }}><PaymentLine label="TIPS" val={splitPay.tips} set={v => setSplitPay({...splitPay, tips: v})} /></div>
            </div>
            <button onClick={finalize} style={{ width: '100%', background: DOJO_GREEN, color: '#000', padding: '20px', fontWeight: '900', marginTop: '10px', border: 'none' }}>FINALIZE SALE</button>
          </div>
        </div>
      )}
      {showHistory && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.95)', zIndex: 200, padding: '20px', overflowY: 'auto' }}>
           <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '20px' }}><span style={{ fontWeight: '900' }}>HISTORY SENTINEL</span><X onClick={() => setShowHistory(false)} /></div>
           <div style={{ fontSize: '10px', color: '#666', borderLeft: `2px solid ${DOJO_GREEN}`, paddingLeft: '10px' }}>Clinical build: Use Ledger for Gold Audit.</div>
        </div>
      )}
    </div>
  );
}

function PaymentLine({ label, val, set, icon }: { label: string, val: number, set: (v: number) => void, icon?: any }) {
  return (
    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: '#000', border: '1px solid #222', padding: '12px' }}>
      <span style={{ fontSize: '12px', display: 'flex', alignItems: 'center', gap: '8px' }}>{icon} {label}</span>
      <input type="number" value={val === 0 ? '' : val} onChange={e => set(parseFloat(e.target.value)||0)} style={{ background: 'transparent', border: 'none', color: DOJO_GREEN, textAlign: 'right', outline: 'none', width: '100px', fontSize: '18px', fontWeight: '900' }} />
    </div>
  );
}
